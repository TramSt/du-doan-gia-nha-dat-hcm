# ============================================
# DỮ LIỆU — KHÔNG commit file dữ liệu lớn lên Git
# ============================================
# Git không dùng để lưu file dữ liệu lớn. Chỉ commit file mẫu nhỏ (sample)
# và hướng dẫn tải trong docs/DATA.md
data/raw/*
data/interim/*
data/processed/*
data/external/*

# Nhưng VẪN GIỮ cấu trúc thư mục và các file mẫu
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/**/README.md
!data/**/*_sample.csv

# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Môi trường ảo
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ============================================
# JUPYTER NOTEBOOK
# ============================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ============================================
# IDE / EDITOR
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject

# ============================================
# HỆ ĐIỀU HÀNH
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# FILE TẠM / OUTPUT TRUNG GIAN
# ============================================
*.log
*.tmp
checkpoint_*.json
checkpoint_*.csv
.cache/
*.pkl
*.joblib

# Giữ lại model cuối cùng nếu nhỏ (<50MB)
!models/final_model.pkl

# ============================================
# FILE NHẠY CẢM
# ============================================
.env
*.key
secrets.yaml
credentials.json
